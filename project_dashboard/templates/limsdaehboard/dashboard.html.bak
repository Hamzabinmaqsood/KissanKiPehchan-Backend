{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Agri One-OS (K2P) — Live Project Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --green:#2E9E33; --green-dark:#1B5E20; --green-deep:#14561A;
  --navy:#1F3864; --navy-2:#17365D;
  --orange:#F57C00; --purple:#7B3FA0; --teal:#00897B; --blue:#1976D2;
  --red:#D32F2F; --grey:#C9CDD3; --grey-2:#8A9099;
  --ink:#1A1A1A; --line:#E3E6EA; --panel:#FFFFFF; --page:#FFFFFF;
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:'Inter',-apple-system,'Segoe UI',Roboto,sans-serif;
  background:#525659; color:var(--ink); padding:18px; -webkit-font-smoothing:antialiased;
}
.sheet{
  width:100%; max-width:1535px; margin:0 auto; background:var(--page);
  border:2px solid var(--green-dark); box-shadow:0 10px 40px rgba(0,0,0,.4);
}
.pad{padding:0 12px}

/* ---------- HEADER ---------- */
.header{display:grid;grid-template-columns:250px 1fr 470px;align-items:center;padding:10px 14px 6px}
.logo{display:flex;align-items:center;gap:8px}
.logo .mark{width:44px;height:44px;flex:none}
.logo .name{font-size:26px;font-weight:700;color:var(--green-dark);line-height:1}
.logo .sub{font-size:15px;font-weight:600;color:var(--green-dark);line-height:1.5}
.head-center{text-align:center}
.head-eyebrow{font-family:'Barlow Condensed',sans-serif;font-size:25px;font-weight:700;letter-spacing:.3px;color:var(--navy-2)}
.head-title{font-family:'Barlow Condensed',sans-serif;font-size:52px;font-weight:700;line-height:.98;color:var(--navy-2);letter-spacing:.5px}
.head-sub{font-size:15.5px;font-weight:600;color:var(--green-dark);margin-top:2px}
.head-right{display:flex;align-items:center;gap:10px;justify-content:flex-end;flex-direction: column;}
.metaboxMain{display: flex; gap:8px}
.brandbox{text-align:right}
.brandbox .syntecx{font-family:'Barlow Condensed',sans-serif;font-size:38px;font-weight:700;letter-spacing:1px;color:var(--navy-2);line-height:1}
.brandbox .syntecx em{font-style:normal;color:rgb(239, 131, 14)}
.brandbox .tag{font-size:10.5px;color:var(--grey-2);letter-spacing:.6px;margin-top:-2px}
.metabox{border:1.5px solid var(--line);border-radius:8px;padding:6px 12px;display:flex;align-items:center;gap:9px;min-width:150px}
.metabox .lbl{font-size:9.5px;font-weight:700;letter-spacing:.7px;color:var(--grey-2);text-align:center}
.metabox .val{font-size:15px;font-weight:700;color:var(--navy-2)}
.metabox .val2{font-size:11px;color:#555}
.metabox .ctr{text-align:center;flex:1}

/* ---------- STAT BAR ---------- */
.statbar{
  display:grid;grid-template-columns:repeat(6,1fr);border:1.5px solid var(--line);
  border-radius:10px;margin:4px 14px 10px;background:#fff;
}
.stat{display:flex;align-items:center;gap:9px;padding:9px 10px;border-right:1px solid var(--line)}
.stat:last-child{border-right:0}
.stat .lbl{font-size:10px;font-weight:700;letter-spacing:.6px;color:var(--grey-2)}
.stat .val{font-size:17px;font-weight:800;color:var(--navy-2);line-height:1.15}
.stat .sub{font-size:10.5px;color:#666}
.stat.health .val{color:var(--green-dark)}

/* ---------- LAYOUT ---------- */
.main{display:grid;grid-template-columns:1.02fr 1fr .98fr;gap:10px;padding:0 14px}
.bottom{display:grid;grid-template-columns:1.72fr 1fr;gap:10px;padding:10px 14px 12px}
.panel{border:1.5px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden}
.ptitle{
  display:inline-block;font-family:'Barlow Condensed',sans-serif;font-size:19px;font-weight:700;
  letter-spacing:.5px;color:#fff;background:var(--green-deep);padding:5px 16px 4px;border-radius:0 0 10px 0;
}
.ptitle.navy{background:var(--navy)}
.pbody{padding:8px 10px 10px}

/* ---------- PARTS TABLE ---------- */
.parts-head{display:grid;grid-template-columns:150px 78px 74px 1fr;font-size:10px;font-weight:700;
  letter-spacing:.4px;color:var(--navy);text-align:center;padding:4px 0 6px;border-bottom:1.5px solid var(--line)}
.part-row{display:grid;grid-template-columns:150px 78px 74px 1fr;align-items:center;
  border-bottom:1px solid var(--line);padding:6px 0}
.part-row:last-child{border-bottom:0}
.part-id{display:flex;align-items:center;gap:7px;background:#F4F6F8;border-radius:8px;padding:7px 6px;margin-right:6px}
.part-num{width:24px;height:24px;flex:none;border-radius:50%;background:var(--green-deep);color:#fff;
  font-size:13px;font-weight:800;display:grid;place-items:center}
.part-name{font-size:10.5px;font-weight:800;color:var(--navy-2);line-height:1.2}
.part-icon{margin-top:3px}
.ring{position:relative;width:60px;height:60px;margin:0 auto}
.ring svg{transform:rotate(-90deg)}
.ring span{position:absolute;inset:0;display:grid;place-items:center;font-size:14px;font-weight:800;color:var(--navy-2)}
.status{text-align:center;font-size:10.5px;font-weight:700}
.status i{display:block;width:10px;height:10px;border-radius:50%;margin:0 auto 4px}
.kpis{padding-left:6px}
.kpi{display:grid;grid-template-columns:1fr auto;font-size:10.5px;padding:1.5px 6px 1.5px 12px;position:relative;color:#333}
.kpi::before{content:"";position:absolute;left:2px;top:7px;width:4px;height:4px;border-radius:50%;background:currentColor}
.kpi b{font-weight:700;color:var(--navy-2)}

/* ---------- GAUGE ---------- */
.gauge{position:relative;width:330px;margin:2px auto 0}
.gauge .txt{position:absolute;left:0;right:0;bottom:14px;text-align:center}
.gauge .pct{font-size:46px;font-weight:800;color:var(--green-dark);line-height:1}
.gauge .cap{font-size:14px;font-weight:600;color:#444}
.gauge .end{position:absolute;bottom:6px;font-size:11px;color:#666}

/* ---------- TIMELINE ---------- */
.sec-title{font-size:12.5px;font-weight:800;color:var(--navy-2);letter-spacing:.4px;margin:8px 0 5px}
.phases{display:grid;gap:0;text-align:center}
.phase{border-left:1px solid var(--line);padding:2px 3px}
.phase:first-child{border-left:0}
.phase .n{font-size:9.5px;font-weight:800;color:var(--navy-2);line-height:1.15}
.phase .w{font-size:9px;color:#666}
.track{position:relative;display:flex;justify-content:space-between;align-items:center;margin:8px 2px 6px}
.track::before{content:"";position:absolute;left:6px;right:6px;top:50%;height:3px;background:#DDE1E6;transform:translateY(-50%);z-index:0}
.track .fill{position:absolute;left:6px;top:50%;height:3px;background:var(--green);transform:translateY(-50%);z-index:0}
.node{position:relative;width:19px;height:19px;border-radius:50%;display:grid;place-items:center;
  font-size:9px;font-weight:700;color:#fff;background:var(--grey);z-index:1}
.node.completed{background:var(--green)}
.node.progress{background:var(--blue)}
.node.planned{background:#C9CDD3}
.node.pending{background:#DFE3E8;color:#7A8087}
.legend{display:flex;gap:16px;justify-content:center;font-size:10.5px;color:#444;margin-bottom:2px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:-1px}

/* ---------- LISTS ---------- */
.bullets{margin-top:2px}
.bul{display:flex;gap:7px;font-size:11px;color:#333;padding:2.5px 0;line-height:1.35}
.bul svg{flex:none;margin-top:1px}
.bul.next{color:var(--navy-2)}
.hr{height:1px;background:var(--line);margin:7px 0 5px}

/* ---------- WEEKLY TABLE ---------- */
table{width:100%;border-collapse:collapse}
.wk th{font-size:10px;font-weight:800;color:var(--navy);letter-spacing:.4px;padding:5px 2px;
  border-bottom:1.5px solid var(--line);text-align:center}
.wk td{font-size:11px;text-align:center;padding:6.5px 2px;border-bottom:1px solid var(--line);color:#333}
.wk td.w{font-weight:800;color:var(--navy-2)}
.wk tr:last-child td{border-bottom:0}
.pos{color:var(--green);font-weight:700}
.zero{color:var(--green);font-weight:700}
.neg{color:var(--red);font-weight:700}

/* ---------- RISK ---------- */
.risks{display:grid;grid-template-columns:repeat(4,1fr);text-align:center;padding:6px 0 2px}
.risk .ico{margin:0 auto 4px}
.risk .lbl{font-size:10px;font-weight:800;color:var(--navy-2);letter-spacing:.3px}
.risk .num{font-size:24px;font-weight:800;color:var(--navy-2);line-height:1.15}
.risk .sub{font-size:9.5px;color:#666}

/* ---------- KPI SNAPSHOT ---------- */
.snap{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;padding:8px 4px 6px}
.snapitem{display:flex;align-items:center;gap:9px;padding:0 8px;border-right:1px solid var(--line)}
.snapitem:last-child{border-right:0}
.snapitem .circ{width:38px;height:38px;flex:none;border-radius:50%;display:grid;place-items:center}
.snapitem .lbl{font-size:9.5px;font-weight:800;color:var(--grey-2);letter-spacing:.4px}
.snapitem .val{font-size:14.5px;font-weight:800;color:var(--navy-2);line-height:1.25}
.snapitem .pct{font-size:14px;font-weight:800;color:var(--navy-2)}

/* ---------- STAKEHOLDER ---------- */
.sh th{font-size:9.5px;font-weight:800;color:var(--navy);letter-spacing:.4px;padding:5px 4px;
  border-bottom:1.5px solid var(--line)}
.sh td{font-size:10.5px;padding:6px 4px;border-bottom:1px solid var(--line);color:#333;text-align:center}
.sh tr:last-child td{border-bottom:0}

/* ---------- FOOTER ---------- */
.footer{background:var(--green-deep);color:#fff;display:grid;grid-template-columns:1.25fr 1fr 1fr 1.05fr;
  align-items:center;padding:12px 18px;gap:10px}
.foot{display:flex;align-items:center;gap:11px;border-left:1px solid rgba(255,255,255,.28);padding-left:16px}
.foot:first-child{border-left:0;padding-left:0}
.foot .t{font-size:13px;font-weight:800;letter-spacing:.3px}
.foot .d{font-size:11.5px;opacity:.92;line-height:1.35}
.foot .big{font-size:13px;font-weight:800;line-height:1.35}
.foot .lite{font-size:12.5px;font-weight:500}

/* ---------- TOOLBAR ---------- */
.toolbar{width:100%;max-width:1535px;margin:0 auto 12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:0 14px}
.btn{font:600 13px 'Inter',sans-serif;color:#fff;background:var(--green-dark);border:0;border-radius:7px;
  padding:9px 16px;cursor:pointer;text-decoration:none;display:inline-block}
.btn.alt{background:var(--navy)}
.btn.ghost{background:#fff;color:var(--navy);border:1px solid #fff}
.toolbar .note{color:#E8EAED;font-size:12.5px}

@media print{
  body{background:#fff;padding:0}
  .toolbar{display:none}
  .sheet{box-shadow:none;border:0;width:100%}
  @page{size:A3 landscape;margin:8mm}
}
@media (max-width:1580px){
  body{padding:10px}
  .sheet,.toolbar{width:100%;max-width:1535px}
}
@media (max-width:1300px){
  .header{grid-template-columns:1fr;row-gap:14px}
  .head-right{justify-content:flex-start}
  .brandbox{text-align:left}
  .metaboxMain{flex-wrap:wrap}
  .main{grid-template-columns:1fr 1fr;gap:8px;padding:0 10px}
  .bottom{grid-template-columns:1fr 1fr;gap:8px;padding:10px 10px 12px}
  .statbar{grid-template-columns:repeat(3,1fr)}
  .parts-head{grid-template-columns:1fr 70px 70px 1fr}
  .part-row{grid-template-columns:1fr 70px 70px 1fr}
}
@media (max-width:1000px){
  .header{grid-template-columns:1fr;row-gap:12px}
  .head-right{width:100%;justify-content:flex-start}
  .brandbox{text-align:left}
  .metaboxMain{gap:6px}
  .statbar{grid-template-columns:1fr 1fr;row-gap:8px}
  .main{grid-template-columns:1fr;gap:8px;padding:0 8px}
  .bottom{grid-template-columns:1fr;gap:8px;padding:10px 8px 12px}
  .parts-head{grid-template-columns:1fr 80px}
  .part-row{grid-template-columns:1fr 80px}
  .part-row .kpis{grid-column:1/-1}
  .kpi{font-size:10px;padding:1px 4px 1px 10px}
  .gauge{width:100%;max-width:330px}
  .gauge svg{width:100%;height:auto}
}
@media (max-width:720px){
  .toolbar{flex-direction:column;align-items:stretch;padding:0 8px}
  .toolbar .btn{width:100%;text-align:center}
  .statbar{grid-template-columns:1fr}
  .main{padding:0 6px}
  .bottom{padding:10px 6px 12px}
  .parts-head{grid-template-columns:1fr}
  .part-row{grid-template-columns:1fr}
  .parts-head div,.part-row > *{padding:6px 0}
  .part-id{gap:6px;padding:6px}
  .head-title{font-size:36px}
  .head-eyebrow{font-size:20px}
  .ptitle{font-size:17px}
  .gauge{width:100%;max-width:100%}
  .track{margin:8px 0 6px}
  .legend{flex-wrap:wrap;justify-content:center}
  .snap{grid-template-columns:1fr;gap:6px}
  .risks{grid-template-columns:1fr}
  .footer{grid-template-columns:1fr;gap:10px;padding:10px 12px}
  .foot{border-left:0;padding-left:0;justify-content:flex-start}
  .foot + .foot{border-top:1px solid rgba(255,255,255,.18);padding-top:10px}
}
</style>
</head>
<body>

<div class="toolbar" id="toolbar">

  <button class="btn alt" onclick="window.print()">Print / Save as PDF</button>

  <span class="note" id="srcNote"></span>
</div>

<div class="sheet" id="sheet"></div>

<script src="{% static 'limsdaehboard/auth.js' %}"></script>
<script>
/* ============ LOGIN GATE — must pass before the dashboard renders ============ */
const SESSION = requireAuth({ subtitle: 'Sign in to view the live project dashboard' });
if(SESSION){
  renderUserBar(document.getElementById('toolbar'), SESSION);
  if(SESSION.role === 'guest'){
    // Guests can look, but can't edit or reset the data
    document.getElementById('editLink').style.display = 'none';
    document.getElementById('resetBtn').style.display = 'none';
  }
}

/* =========================================================
   DEFAULT DATA — every value on the dashboard lives here
   ========================================================= */
const DEFAULT_DATA = {
  brand:{
    productName:"AgriOne-OS", productSub:"(K2P)",
    companyA:"SYNTEC", companyB:"X", companyTag:"Simplifying Technology"
  },
  header:{
    eyebrow:"AGRI ONE-OS (K2P) PROJECT",
    title:"LIVE PROJECT DASHBOARD",
    subtitle:"Together, we enable a Digital & Prosperous Agriculture Ecosystem",
    updatedLabel:"LAST UPDATED", updatedDate:"11 Aug 2026", updatedTime:"11:00 AM",
    pmLabel:"REPORTING PM", pmName:"Oumar Nawaz", pmRole:"Project & Commercial Manager"
  },
  stats:[
    {icon:"calendar", label:"PROJECT DURATION", value:"17 WEEKS", sub:"(15 Jul – 10 Nov 2026)", bind:"duration"},
    {icon:"calendar", label:"CURRENT WEEK",     value:"WEEK 4",   sub:"(5 – 11 Aug 2026)",      bind:"currentWeek"},
    {icon:"pulse",    label:"PROJECT HEALTH",   value:"GOOD",     sub:"On Track", health:true,  bind:"health"},
    {icon:"target",   label:"OVERALL PROGRESS", value:"32%",      sub:"Completed",              bind:"overall"},
    {icon:"calendar", label:"DAYS ELAPSED",     value:"21 / 119", sub:"Days",                   bind:"daysElapsed"},
    {icon:"hourglass",label:"DAYS REMAINING",   value:"98",       sub:"Days",                   bind:"daysRemaining"}
  ],
  partsTitle:"5 PARTS PROGRESS & KPI SUMMARY",
  parts:[
    {num:1,name:"SOFTWARE<br>(APP & PORTAL)",icon:"code",progress:62,status:"On Track",color:"#2E9E33",weight:1,
     kpis:[{l:"Modules Completed",v:"36 / 58"},{l:"Bugs Closed",v:"42"},{l:"Module Completion",v:"11 / 18"},{l:"Unit Test Coverage",v:"78%"}]},
    {num:2,name:"GIS & GEO<br>INTELLIGENCE",icon:"globe",progress:55,status:"On Track",color:"#2E9E33",weight:1,
     kpis:[{l:"Datasets Integrated",v:"7 / 14"},{l:"Maps / Layers Created",v:"16"},{l:"Accuracy Rate",v:"92%"}]},
    {num:3,name:"MARKETING",icon:"megaphone",progress:50,status:"In Progress",color:"#F57C00",weight:1,
     kpis:[{l:"Campaigns Launched",v:"2 / 6"},{l:"Content Assets",v:"24"},{l:"Reach (Farmers)",v:"125K"}]},
    {num:4,name:"HARDWARE, CLOUD<br>& INFRASTRUCTURE",icon:"cloud",progress:48,status:"In Progress",color:"#7B3FA0",weight:1,
     kpis:[{l:"Infra Setup",v:"65%"},{l:"Cloud Services",v:"5 / 8"},{l:"Security Compliance",v:"70%"}]},
    {num:5,name:"FIELD MARKETING",icon:"people",progress:45,status:"In Progress",color:"#00897B",weight:1,
     kpis:[{l:"Field Teams Onboarded",v:"6 / 12"},{l:"Locations Covered",v:"18"},{l:"Farmers Engaged",v:"8,450"}]}
  ],
  overallTitle:"OVERALL PROJECT PROGRESS",
  overall:{percent:32, caption:"Completed", minLabel:"0%", maxLabel:"100%"},
  timelineTitle:"EXECUTION TIMELINE (17 WEEKS)",
  phases:[
    {name:"FOUNDATION", weeks:"(2 WEEKS)", span:2},
    {name:"PLATFORM DEVELOPMENT", weeks:"(4 WEEKS)", span:4},
    {name:"PILOT & VALIDATION", weeks:"(4 WEEKS)", span:4},
    {name:"AI & FINANCIAL SERVICES", weeks:"(4 WEEKS)", span:4},
    {name:"NATIONAL ROLLOUT", weeks:"(3 WEEKS)", span:3}
  ],
  nodes:["completed","completed","completed","completed","completed","progress",
         "planned","planned","planned","planned","planned",
         "pending","pending","pending","pending","pending","pending"],
  legend:[{l:"Completed",c:"#2E9E33"},{l:"In Progress",c:"#1976D2"},{l:"Planned",c:"#C9CDD3"},{l:"Pending",c:"#DFE3E8"}],
  highlightsTitle:"KEY HIGHLIGHTS (THIS WEEK)",
  highlights:[
    "Android app uploaded on Play Store (pending final approval)",
    "iOS app uploaded on App Store",
    "Contract secured for 4 months accelerated delivery",
    "Initial scope session for FSD (GIS, Marketing, Software, Field Marketing) concluded. 2nd rounds to follow in coming days."
  ],
  upcomingTitle:"UPCOMING NEXT WEEK (WEEK 5)",
  upcoming:[
    "Continue development of core modules & API integrations",
    "GIS data verification and map layer expansion",
    "Marketing campaigns optimization & content roll-out",
    "Field team onboarding & training kick-off",
    "Infrastructure scaling & security hardening"
  ],
  weeklyTitle:"WEEKLY PROGRESS OVERVIEW",
  weekly:[
    {week:"W1", period:"03 – 09 Aug", plan:"5%",  actual:"5%",  variance:"0%",  status:"done"},
    {week:"W2", period:"10 – 16 Aug", plan:"10%", actual:"11%", variance:"+1%", status:"done"},
    {week:"W3", period:"17 – 23 Aug", plan:"15%", actual:"15%", variance:"0%",  status:"done"},
    {week:"W4", period:"24 – 30 Aug", plan:"20%", actual:"21%", variance:"+1%", status:"done"},
    {week:"W5", period:"31 Aug – 06 Sep", plan:"25%", actual:"27%", variance:"+2%", status:"done"},
    {week:"W6", period:"07 – 13 Aug", plan:"30%", actual:"-", variance:"-", status:"wait"},
    {week:"W7", period:"14 – 20 Aug", plan:"35%", actual:"-", variance:"-", status:"wait"},
    {week:"W8", period:"21 – 27 Aug", plan:"40%", actual:"-", variance:"-", status:"wait"}
  ],
  riskTitle:"RISK & ISSUE SUMMARY",
  risks:[
    {icon:"warning", label:"HIGH RISKS",   value:"2",  sub:"Action Required", color:"#D32F2F"},
    {icon:"alert",   label:"MEDIUM RISKS", value:"1",  sub:"Monitoring",      color:"#F57C00"},
    {icon:"info",    label:"OPEN ISSUES",  value:"6",  sub:"In Progress",     color:"#1976D2"},
    {icon:"check",   label:"RESOLVED",     value:"12", sub:"Closed",          color:"#2E9E33"}
  ],
  snapTitle:"PROJECT KPI SNAPSHOT (CUMULATIVE)",
  snapshot:[
    {icon:"download", label:"APP DOWNLOADS",     value:"45,620 / 300,000", pct:"15%", color:"#2E9E33"},
    {icon:"user",     label:"VERIFIED SIGN-UPS", value:"18,230 / 120,000", pct:"15%", color:"#1976D2"},
    {icon:"users",    label:"ACTIVE USERS (MAU)",value:"9,850 / 60,000",   pct:"16%", color:"#F57C00"},
    {icon:"wallet",   label:"PAYING USERS",      value:"1,250 / 10,000",   pct:"13%", color:"#7B3FA0"},
    {icon:"money",    label:"REVENUE (PKR)",     value:"8.6M / 50M",       pct:"17%", color:"#00897B"}
  ],
  stakeTitle:"STAKEHOLDER ACTIONS & DEADLINES",
  stakeHead:["STAKEHOLDER","ACTION REQUIRED","DUE DATE","STATUS"],
  stakeholders:[
    {who:"All Stakeholders", action:"Submit Implementation Plan",     due:"15th Aug 2026", status:"wait"},
    {who:"All Stakeholders", action:"Share Dependencies & Roadblocks",due:"15th Aug 2026", status:"wait"},
    {who:"All Stakeholders", action:"Confirm Action Items & Owners",  due:"15th Aug 2026", status:"wait"}
  ],
  footer:[
    {icon:"target", title:"OUR GOAL", desc:"Deliver a robust, scalable and impactful system<br>for millions of farmers across Pakistan."},
    {icon:"team",   title:"ONE TEAM. ONE GOAL.", desc:"MILLIONS OF FARMERS. LIMITLESS IMPACT.", bold:true},
    {icon:"leaf",   title:"EMPOWER FARMERS.", desc:"DRIVE PROSPERITY.", bold:true},
    {icon:"sprout", title:"", desc:"Let's build the future of agriculture – together!", lite:true}
  ],

  /* ---- AUTO-CALCULATION SETTINGS ----
     Set any mode to "manual" to type that value yourself instead. */
  auto:{
    enabled:true,
    startDate:"2026-07-15",     // project start
    endDate:"2026-11-10",       // project end
    asOfDate:"2026-08-11",      // "as of" date = the reporting date
    overallMode:"weekly",       // weekly = latest actual % in the weekly table | parts = weighted avg of the 5 parts | manual
    partsMode:"kpis",           // kpis = each part % from its own KPI lines | manual
    varianceMode:"auto",        // actual - plan
    statusMode:"auto",          // week ticked once an actual % is entered
    planMode:"manual",          // linear = plan % spread evenly to 100% | manual
    periodsMode:"manual",       // auto = week dates generated from the start date | manual
    nodesMode:"auto",           // timeline dots follow the current week | manual
    plannedWindow:5,            // how many weeks after the current one show as "Planned"
    snapshotMode:"auto",        // KPI snapshot % from actual / target
    healthMode:"auto",          // health from the latest variance
    daysMode:"auto",            // days elapsed / remaining from the dates
    durationMode:"auto",        // duration + date range from the dates
    currentWeekMode:"auto",     // week number + its date range from the dates
    titlesMode:"auto"           // week counts inside section titles
  }
};

/* =========================================================
   AUTO-CALCULATION ENGINE
   ========================================================= */
const MONTHS=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const DAY=864e5;
function pDate(s){const d=new Date(String(s||'')+"T00:00:00");return isNaN(d.getTime())?null:d;}
function fD(d){return d.getDate()+" "+MONTHS[d.getMonth()];}
function fDY(d){return fD(d)+" "+d.getFullYear();}
function fRange(a,b,year){
  if(!a||!b) return "";
  const y=year?(" "+b.getFullYear()):"";
  return a.getMonth()===b.getMonth()
    ? `${a.getDate()} – ${b.getDate()} ${MONTHS[b.getMonth()]}${y}`
    : `${fD(a)} – ${fD(b)}${y}`;
}
function toNum(s){
  if(typeof s==='number') return s;
  if(typeof s!=='string') return NaN;
  const t=s.replace(/,/g,'').replace(/%/g,'').replace(/PKR|Rs\.?/gi,'').trim();
  const m=t.match(/^([+-]?\d*\.?\d+)\s*([KkMmBb])?$/);
  if(!m) return NaN;
  let n=parseFloat(m[1]); const suf=(m[2]||'').toLowerCase();
  if(suf==='k')n*=1e3; else if(suf==='m')n*=1e6; else if(suf==='b')n*=1e9;
  return n;
}
function ratioPct(s){
  if(typeof s!=='string') return NaN;
  const p=s.split('/');
  if(p.length===2){const a=toNum(p[0]),b=toNum(p[1]); if(isFinite(a)&&isFinite(b)&&b>0) return a/b*100;}
  const one=toNum(s);
  return (s.includes('%')&&isFinite(one))?one:NaN;
}

function computeAll(D){
  const A=D.auto||{};
  const out={totals:null};
  if(A.enabled===false) return out;

  const start=pDate(A.startDate), end=pDate(A.endDate), asOf=pDate(A.asOfDate);
  let totalDays=0, elapsed=0, remaining=0, totalWeeks=0, curWeek=1, wkS=null, wkE=null;
  if(start&&end&&asOf&&end>start){
    totalDays  = Math.round((end-start)/DAY)+1;
    elapsed    = Math.max(0,Math.min(totalDays,Math.round((asOf-start)/DAY)+1));
    remaining  = Math.max(0,totalDays-elapsed);
    totalWeeks = Math.ceil(totalDays/7);
    curWeek    = Math.max(1,Math.min(totalWeeks,Math.ceil(elapsed/7)||1));
    wkS = new Date(start.getTime()+(curWeek-1)*7*DAY);
    wkE = new Date(Math.min(end.getTime(), wkS.getTime()+6*DAY));
  }

  /* --- part % from its KPI lines --- */
  if(A.partsMode==='kpis'){
    D.parts.forEach(p=>{
      const vals=(p.kpis||[]).map(k=>ratioPct(k.v)).filter(v=>isFinite(v));
      if(vals.length) p.progress=Math.round(vals.reduce((a,b)=>a+b,0)/vals.length);
    });
  }

  /* --- weekly table: periods, plan, variance, status --- */
  D.weekly.forEach((w,i)=>{
    if(A.planMode==='linear'&&totalWeeks) w.plan=Math.round((i+1)/totalWeeks*100)+"%";
    if(A.periodsMode==='auto'&&start){
      const s=new Date(start.getTime()+i*7*DAY);
      const e=new Date(end?Math.min(end.getTime(),s.getTime()+6*DAY):s.getTime()+6*DAY);
      w.period=fRange(s,e,false);
    }
    const a=toNum(w.actual), p=toNum(w.plan);
    if(A.varianceMode!=='manual'){
      if(isFinite(a)&&isFinite(p)){const v=Math.round((a-p)*10)/10; w.variance=(v>0?'+':'')+v+'%';}
      else w.variance='-';
    }
    if(A.statusMode!=='manual') w.status=isFinite(a)?'done':'wait';
  });

  /* --- overall progress --- */
  let overall=Number(D.overall.percent)||0, overallFrom='typed in manually';
  if(A.overallMode==='weekly'){
    for(let i=D.weekly.length-1;i>=0;i--){
      const a=toNum(D.weekly[i].actual);
      if(isFinite(a)){overall=a; overallFrom='latest actual % ('+D.weekly[i].week+')'; break;}
    }
  }else if(A.overallMode==='parts'){
    let ws=0,sum=0;
    D.parts.forEach(p=>{const w=(Number(p.weight)||1); ws+=w; sum+=w*(Number(p.progress)||0);});
    overall= ws?sum/ws:0; overallFrom='weighted average of the 5 parts';
  }
  overall=Math.round(overall);
  D.overall.percent=overall;

  /* --- project health from the latest variance --- */
  let hv='GOOD', hs='On Track', lastVar=null;
  for(let i=D.weekly.length-1;i>=0;i--){
    const a=toNum(D.weekly[i].actual), p=toNum(D.weekly[i].plan);
    if(isFinite(a)&&isFinite(p)){lastVar=a-p; break;}
  }
  if(lastVar!==null){
    if(lastVar>=0){hv='GOOD';hs='On Track';}
    else if(lastVar>=-5){hv='WATCH';hs='Minor Slippage';}
    else {hv='AT RISK';hs='Action Required';}
  }

  /* --- top stat strip --- */
  D.stats.forEach(s=>{
    switch(s.bind){
      case 'duration':
        if(A.durationMode!=='manual'&&start&&end){s.value=totalWeeks+' WEEKS'; s.sub=`(${fD(start)} – ${fDY(end)})`;}
        break;
      case 'currentWeek':
        if(A.currentWeekMode!=='manual'&&wkS){s.value='WEEK '+curWeek; s.sub=`(${fRange(wkS,wkE,true)})`;}
        break;
      case 'health':
        if(A.healthMode!=='manual'){s.value=hv; s.sub=hs;}
        break;
      case 'overall':
        s.value=overall+'%';
        break;
      case 'daysElapsed':
        if(A.daysMode!=='manual'&&totalDays){s.value=elapsed+' / '+totalDays;}
        break;
      case 'daysRemaining':
        if(A.daysMode!=='manual'&&totalDays){s.value=String(remaining);}
        break;
    }
  });

  /* --- timeline dots --- */
  if(A.nodesMode!=='manual'){
    const n=D.phases.reduce((s,p)=>s+Math.max(1,Math.round(Number(p.span)||1)),0)||D.nodes.length;
    const win=Number(A.plannedWindow)||0;
    const arr=[];
    for(let i=1;i<=n;i++)
      arr.push(i<curWeek?'completed': i===curWeek?'progress': i<=curWeek+win?'planned':'pending');
    D.nodes=arr;
  }

  /* --- week counts inside titles --- */
  if(A.titlesMode!=='manual'){
    D.timelineTitle=String(D.timelineTitle).replace(/\(\s*\d+\s*WEEKS?\s*\)/i,`(${D.nodes.length} WEEKS)`);
    D.upcomingTitle=String(D.upcomingTitle).replace(/\(\s*WEEK\s*\d+\s*\)/i,`(WEEK ${Math.min(curWeek+1,D.nodes.length)})`);
  }

  /* --- KPI snapshot % from actual / target --- */
  if(A.snapshotMode!=='manual'){
    D.snapshot.forEach(k=>{const r=ratioPct(k.value); if(isFinite(r)) k.pct=Math.round(r)+'%';});
  }

  out.totals={totalDays,elapsed,remaining,totalWeeks,curWeek,wkS,wkE,overall,overallFrom,health:hv+' — '+hs,lastVar};
  return out;
}

/* ===================== ICONS ===================== */
const I = {
  calendar:(c='#2E7D32',s=26)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="1.8"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/><rect x="6.5" y="12" width="3" height="3" rx=".6" fill="${c}" stroke="none"/><rect x="11" y="12" width="3" height="3" rx=".6" fill="${c}" stroke="none"/></svg>`,
  pulse:(c='#1B5E20',s=28)=>`<svg width="${s}" height="${s}" viewBox="0 0 28 24" fill="none" stroke="${c}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12h5l3-8 5 16 3-8h9"/></svg>`,
  target:(c='#2E7D32',s=27)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="1.8"><circle cx="11" cy="13" r="8.5"/><circle cx="11" cy="13" r="4.5"/><circle cx="11" cy="13" r="1.3" fill="${c}"/><path d="M15 9l6-6M17.5 3.5h4v4" stroke-linecap="round"/></svg>`,
  hourglass:(c='#2E7D32',s=26)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="1.8"><path d="M6 2.5h12M6 21.5h12M7 2.5v4c0 2.6 5 4.2 5 5.5 0 1.3-5 2.9-5 5.5v4M17 2.5v4c0 2.6-5 4.2-5 5.5 0 1.3 5 2.9 5 5.5v4"/><path d="M9 18.5h6" stroke-width="3" stroke-linecap="round"/></svg>`,
  code:(c)=>`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="1.8"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8.5 8.5L6 11l2.5 2.5M15.5 8.5L18 11l-2.5 2.5M13 8l-2 6" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 21h6" stroke-linecap="round"/></svg>`,
  globe:(c)=>`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="1.8"><circle cx="12" cy="12" r="9.2"/><path d="M3 12h18M12 2.8c2.6 2.7 3.8 6 3.8 9.2S14.6 18.6 12 21.2C9.4 18.6 8.2 15.4 8.2 12S9.4 5.5 12 2.8z"/></svg>`,
  megaphone:(c)=>`<svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="1.8" stroke-linejoin="round"><path d="M3 10v4a1.5 1.5 0 001.5 1.5H7l7 4.5V4L7 8.5H4.5A1.5 1.5 0 003 10z"/><path d="M17.5 8.5a5 5 0 010 7" stroke-linecap="round"/><path d="M6.5 15.5l1 5h3l-1-5" /></svg>`,
  cloud:(c)=>`<svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="1.8" stroke-linecap="round"><path d="M6.5 16.5a3.6 3.6 0 01.4-7.2A5.2 5.2 0 0117 10.3a3.1 3.1 0 01-.4 6.2H6.5z"/><path d="M4 20h16M8 20v-2M16 20v-2"/></svg>`,
  people:(c)=>`<svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="1.8" stroke-linecap="round"><circle cx="7.5" cy="7" r="2.8"/><circle cx="16.5" cy="7" r="2.8"/><path d="M2.5 19c0-3 2.2-5.2 5-5.2s5 2.2 5 5.2M11.5 19c0-3 2.2-5.2 5-5.2s5 2.2 5 5.2"/></svg>`,
  check:(c='#2E9E33',s=13)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="${c}"><circle cx="12" cy="12" r="11"/><path d="M7 12.4l3.3 3.3L17.2 9" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  arrow:(c='#1F3864',s=12)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4l8 8-8 8"/><path d="M13 4l8 8-8 8" opacity=".55"/></svg>`,
  clock:(c='#5B6470',s=15)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="2"><circle cx="12" cy="12" r="9.5"/><path d="M12 6.8V12l3.4 2.2" stroke-linecap="round"/></svg>`,
  warning:(c='#D32F2F',s=30)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="${c}"><path d="M12 2.6l10.4 18H1.6z"/><path d="M12 8.6v6M12 17.4v.1" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/></svg>`,
  alert:(c='#F57C00',s=30)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="${c}"><circle cx="12" cy="12" r="10.5"/><path d="M12 6.5v7M12 16.6v.1" stroke="#fff" stroke-width="2.3" stroke-linecap="round"/></svg>`,
  info:(c='#1976D2',s=30)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="${c}"><circle cx="12" cy="12" r="10.5"/><path d="M12 10.6v6.8M12 7.2v.1" stroke="#fff" stroke-width="2.3" stroke-linecap="round"/></svg>`,
  checkbig:(c='#2E9E33',s=30)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="2"><circle cx="12" cy="12" r="10.5"/><path d="M7.2 12.3l3.4 3.4 6.4-6.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  download:()=>`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5v11M7 10l5 5 5-5M4.5 19.5h15"/></svg>`,
  user:()=>`<svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><circle cx="12" cy="8" r="4"/><path d="M4 20.5c0-4.2 3.6-6.5 8-6.5s8 2.3 8 6.5z"/></svg>`,
  users:()=>`<svg width="21" height="21" viewBox="0 0 24 24" fill="#fff"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16" cy="8.5" r="3.2"/><path d="M1.8 19c0-3.2 2.8-5 6.2-5s6.2 1.8 6.2 5zM10.5 19c.4-3.2 2.6-5 5.5-5 3.4 0 6.2 1.8 6.2 5z"/></svg>`,
  wallet:()=>`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="2.5" y="6" width="19" height="13" rx="2.5"/><path d="M2.5 10.5h19M16 14.5h2.5" stroke-linecap="round"/></svg>`,
  money:()=>`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M6 3.5h9l4 4v13H6z" stroke-linejoin="round"/><path d="M12 8v9M14.5 9.6c-.6-.7-1.6-1-2.6-1-1.3 0-2.4.7-2.4 1.9 0 2.6 5 1.4 5 4 0 1.3-1.2 2-2.6 2-1 0-2-.3-2.6-1" stroke-linecap="round"/></svg>`,
  targetW:()=>`<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7"><circle cx="11" cy="13" r="8.6"/><circle cx="11" cy="13" r="4.6"/><circle cx="11" cy="13" r="1.3" fill="#fff"/><path d="M15 9l6-6M17.5 3.5h4v4" stroke-linecap="round"/></svg>`,
  team:()=>`<svg width="32" height="30" viewBox="0 0 32 24" fill="#fff"><circle cx="16" cy="6" r="3.4"/><circle cx="6.5" cy="8.5" r="3"/><circle cx="25.5" cy="8.5" r="3"/><path d="M9.5 20c0-3.8 2.9-6.4 6.5-6.4s6.5 2.6 6.5 6.4zM0 20c0-3.2 2.6-5.4 6-5.4 1 0 2 .2 2.8.6-1.4 1.3-2.3 3-2.5 4.8zM32 20h-6.3c-.2-1.8-1.1-3.5-2.5-4.8.8-.4 1.8-.6 2.8-.6 3.4 0 6 2.2 6 5.4z"/></svg>`,
  leaf:()=>`<svg width="30" height="30" viewBox="0 0 24 24" fill="#fff"><path d="M12 22c0-6 0-9 0-12 0 0-4.5.6-6.4 3.6C3.6 16.7 5 21 5 21s3.6.5 5.5-1.2M12 10c0-4 2-7.5 6.5-8.5 0 0 1.5 4.5-.6 7.6C16 12.2 12 12 12 12"/></svg>`,
  sprout:()=>`<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round"><path d="M12 21v-8"/><path d="M12 13C12 9 9 6.5 4.5 6.5c0 4.5 3 6.5 7.5 6.5z" fill="#fff" stroke="none"/><path d="M12 13c0-3.5 2.6-6 6.8-6 0 4.2-2.8 6-6.8 6z" fill="#fff" stroke="none"/></svg>`,
  leafLogo:()=>`<svg width="44" height="44" viewBox="0 0 48 48" fill="none"><path d="M24 42V22" stroke="#1B5E20" stroke-width="2.6" stroke-linecap="round"/><path d="M23 24C23 15 17 8 6 8c0 11 7 16 17 16z" fill="#4CAF50"/><path d="M25 24c0-8 5.5-14 16-14 0 10-6.5 14-16 14z" fill="#1B5E20"/><path d="M24 20c-1-4-4-7-8-9M24 18c1-3.5 4-6.5 8-8" stroke="#fff" stroke-width="1.1" stroke-linecap="round" opacity=".55"/></svg>`,
  pmIcon:()=>`<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1F3864" stroke-width="1.8"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20.5c0-4 3.4-6.4 7.5-6.4s7.5 2.4 7.5 6.4" stroke-linecap="round"/></svg>`
};

/* ===================== RENDER ===================== */
function el(html){const d=document.createElement('div');d.innerHTML=html.trim();return d.firstElementChild;}

function ring(pct,color){
  const r=25, c=2*Math.PI*r, off=c*(1-pct/100);
  return `<div class="ring">
    <svg width="60" height="60" viewBox="0 0 60 60">
      <circle cx="30" cy="30" r="${r}" fill="none" stroke="#E7EAEE" stroke-width="7"/>
      <circle cx="30" cy="30" r="${r}" fill="none" stroke="${color}" stroke-width="7"
        stroke-linecap="round" stroke-dasharray="${c.toFixed(1)}" stroke-dashoffset="${off.toFixed(1)}"/>
    </svg><span>${pct}%</span></div>`;
}

function gauge(pct) {
  const R = 125, cx = 165, cy = 150, w = 26;

  const a = Math.PI * (1 - pct / 100);

  const x = cx + R * Math.cos(a);
  const y = cy - R * Math.sin(a);

  return `<div class="gauge">
    <svg width="330" height="172" viewBox="0 0 330 172">

      <!-- Background -->
      <path
        d="M ${cx-R} ${cy}
           A ${R} ${R} 0 0 1 ${cx+R} ${cy}"
        fill="none"
        stroke="#E4E7EB"
        stroke-width="${w}"
        stroke-linecap="round"
      />

      <!-- Progress -->
      <path
        d="M ${cx-R} ${cy}
           A ${R} ${R} 0 0 1 ${x.toFixed(2)} ${y.toFixed(2)}"
        fill="none"
        stroke="#2E9E33"
        stroke-width="${w}"
        stroke-linecap="round"
      />

    </svg>

    <div class="txt">
      <div class="pct">${pct}%</div>
      <div class="cap">${D.overall.caption}</div>
    </div>

    <div class="end" style="left:2px">${D.overall.minLabel}</div>
    <div class="end" style="right:2px">${D.overall.maxLabel}</div>
  </div>`;
}
let D = DEFAULT_DATA;

function render(){
  const s=document.getElementById('sheet');
  const statIcons={calendar:I.calendar,pulse:I.pulse,target:I.target,hourglass:I.hourglass};
  const riskIcons={warning:I.warning,alert:I.alert,info:I.info,check:I.checkbig};
  const snapIcons={download:I.download,user:I.user,users:I.users,wallet:I.wallet,money:I.money};
  const footIcons={target:I.targetW,team:I.team,leaf:I.leaf,sprout:I.sprout};
  const partIcons={code:I.code,globe:I.globe,megaphone:I.megaphone,cloud:I.cloud,people:I.people};

  const totalWeeks=D.nodes.length;
  const doneCount=D.nodes.filter(n=>n==='completed').length;
  const fillPct = Math.min(100, Math.max(0, totalWeeks>1 ? ((doneCount-0.5)/(totalWeeks-1))*100 : 0));

  s.innerHTML = `
  <!-- HEADER -->
  <div class="header">
    <div class="logo">
      <div class="mark">${I.leafLogo()}</div>
      <div><div class="name">${D.brand.productName}</div><div class="sub">${D.brand.productSub}</div></div>
    </div>
    <div class="head-center">
      <div class="head-eyebrow">${D.header.eyebrow}</div>
      <div class="head-title">${D.header.title}</div>
      <div class="head-sub">${D.header.subtitle} ??</div>
    </div>
    <div class="head-right">
      <div class="brandbox">
        <div class="syntecx">${D.brand.companyA}<em>${D.brand.companyB}</em></div>
        <div class="tag">${D.brand.companyTag}</div>
      </div>
      <div class="metaboxMain">
              <div class="metabox">
        ${I.calendar('#1F3864',22)}
        <div class="ctr"><div class="lbl">${D.header.updatedLabel}</div>
        <div class="val">${D.header.updatedDate}</div><div class="val2">${D.header.updatedTime}</div></div>
      </div>
      <div class="metabox">
        ${I.pmIcon()}
        <div class="ctr"><div class="lbl">${D.header.pmLabel}</div>
        <div class="val">${D.header.pmName}</div><div class="val2">${D.header.pmRole}</div></div>
      </div>

        </div>
    </div>
  </div>

  <!-- STAT BAR -->
  <div class="statbar">
    ${D.stats.map(st=>`<div class="stat${st.health?' health':''}">
      ${(statIcons[st.icon]||I.calendar)()}
      <div><div class="lbl">${st.label}</div><div class="val">${st.value}</div><div class="sub">${st.sub}</div></div>
    </div>`).join('')}
  </div>

  <!-- MAIN -->
  <div class="main">
    <!-- LEFT -->
    <div class="panel">
      <div class="ptitle">${D.partsTitle}</div>
      <div class="pbody">
        <div class="parts-head"><div>PART</div><div>PROGRESS</div><div>STATUS</div><div>KEY KPI (ACTUAL / TARGET)</div></div>
        ${D.parts.map(p=>`
        <div class="part-row">
          <div class="part-id">
            <div class="part-num">${p.num}</div>
            <div><div class="part-name">${p.name}</div><div class="part-icon">${(partIcons[p.icon]||I.code)(p.color)}</div></div>
          </div>
          ${ring(p.progress,p.color)}
          <div class="status" style="color:${p.color}"><i style="background:${p.color}"></i>${p.status}</div>
          <div class="kpis">${p.kpis.map(k=>`<div class="kpi" style="color:${p.color}">
            <span style="color:#333">${k.l}</span><b>${k.v}</b></div>`).join('')}</div>
        </div>`).join('')}
      </div>
    </div>

    <!-- CENTER -->
    <div class="panel">
      <div class="ptitle">${D.overallTitle}</div>
      <div class="pbody">
        ${gauge(D.overall.percent)}
        <div class="sec-title">${D.timelineTitle}</div>

        <div class="track">
          <div class="fill" style="width:calc(${Math.max(0,fillPct)}% - 6px)"></div>
          ${D.nodes.map((n,i)=>`<div class="node ${n}">${i+1}</div>`).join('')}
        </div>
        <div class="legend">${D.legend.map(l=>`<span><i style="background:${l.c}"></i>${l.l}</span>`).join('')}</div>
        <div class="hr"></div>
        <div class="sec-title">${D.highlightsTitle}</div>
        <div class="bullets">${D.highlights.map(h=>`<div class="bul">${I.check()}<span>${h}</span></div>`).join('')}</div>
        <div class="sec-title" style="margin-top:9px">${D.upcomingTitle}</div>
        <div class="bullets">${D.upcoming.map(u=>`<div class="bul next">${I.arrow()}<span>${u}</span></div>`).join('')}</div>
      </div>
    </div>

    <!-- RIGHT -->
    <div>
      <div class="panel">
        <div class="ptitle navy">${D.weeklyTitle}</div>
        <div class="pbody">
          <table class="wk">
            <tr><th>WEEK</th><th>PERIOD</th><th>PLAN (%)</th><th>ACTUAL (%)</th><th>VARIANCE</th><th>STATUS</th></tr>
            ${D.weekly.map(w=>{
              const v=(w.variance||'').trim();
              const cls = v.startsWith('+')?'pos': v.startsWith('-')&&v.length>1?'neg': v==='0%'?'zero':'';
              return `<tr><td class="w">${w.week}</td><td>${w.period}</td><td>${w.plan}</td>
              <td>${w.actual}</td><td class="${cls}">${v}</td>
              <td>${w.status==='done'?I.check('#2E9E33',17):I.clock('#5B6470',17)}</td></tr>`;
            }).join('')}
          </table>
        </div>
      </div>
      <div class="panel" style="margin-top:10px">
        <div class="ptitle navy">${D.riskTitle}</div>
        <div class="pbody">
          <div class="risks">
            ${D.risks.map(r=>`<div class="risk">
              <div class="ico">${(riskIcons[r.icon]||I.info)(r.color,30)}</div>
              <div class="lbl">${r.label}</div><div class="num">${r.value}</div><div class="sub">${r.sub}</div>
            </div>`).join('')}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BOTTOM -->
  <div class="bottom">
    <div class="panel">
      <div class="ptitle navy">${D.snapTitle}</div>
      <div class="snap">
        ${D.snapshot.map(k=>`<div class="snapitem">
          <div class="circ" style="background:${k.color}">${(snapIcons[k.icon]||I.user)()}</div>
          <div><div class="lbl">${k.label}</div><div class="val">${k.value}</div><div class="pct">${k.pct}</div></div>
        </div>`).join('')}
      </div>
    </div>
    <div class="panel">
      <div class="ptitle navy">${D.stakeTitle}</div>
      <div class="pbody">
        <table class="sh">
          <tr>${D.stakeHead.map(h=>`<th>${h}</th>`).join('')}</tr>
          ${D.stakeholders.map(r=>`<tr><td>${r.who}</td><td>${r.action}</td><td>${r.due}</td>
            <td>${r.status==='done'?I.check('#2E9E33',15):I.clock('#5B6470',15)}</td></tr>`).join('')}
        </table>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="footer">
    ${D.footer.map(f=>`<div class="foot">
      ${(footIcons[f.icon]||I.leaf)()}
      <div>${f.title?`<div class="t">${f.title}</div>`:''}
      <div class="${f.bold?'big':(f.lite?'lite':'d')}">${f.desc}</div></div>
    </div>`).join('')}
  </div>`;
}

/* ============ LOAD SAVED VALUES (editor ? dashboard) ============ */
function deepMerge(base,over){
  if(Array.isArray(over)) return over;
  if(over && typeof over==='object'){
    const out={...base};
    for(const k in over) out[k]=deepMerge(base?base[k]:undefined,over[k]);
    return out;
  }
  return over===undefined?base:over;
}
  async function loadData() {
    const note =
      document.getElementById(
        'srcNote'
      );

    note.textContent =
      'Loading live dashboard...';

    const response =
      await apiFetch(
        '/api/lims-dashboard/k2p/',
        {
          cache: 'no-store'
        }
      );

    if (!response.ok) {

      let message =
        'Unable to load dashboard.';

      try {
        const body =
          await response.json();

        message =
          body.detail ||
          body.message ||
          message;

      } catch (e) { }

      throw new Error(
        message
      );
    }

    /*
      Backend response is now the source of truth.

      No:
        data.json
        localStorage
        URL hash
    */
    D =
      await response.json();

    note.textContent =
      'Live values loaded from LIMS backend.';
  }


  function resetData() {
    /*
      Old localStorage reset is no longer needed.
      Refresh simply reloads the latest backend data.
    */
    location.reload();
  }


  async function initDashboard() {

    const note =
      document.getElementById(
        'srcNote'
      );

    try {

      await loadData();

      /*
        IMPORTANT:
        computeAll(D) is intentionally NOT called here.

        Django now performs:
          duration
          current week
          days
          overall progress
          health
          part progress
          variance
          snapshot %
          timeline nodes
      */

      render();

    } catch (error) {

      console.error(
        error
      );

      note.textContent =
        'Dashboard could not be loaded: ' +
        error.message;
    }
  }


  if (SESSION) {
    initDashboard();
  }
</script>
</body>
</html>